# ==============================================================================
# NPP Ghana Social Listening Desk · Production Environment Variables
# Copy to `.env` and fill in secrets before running in production.
# ==============================================================================

# --- Core Django Settings ----------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY="generate-a-strong-random-64-character-secret-key-here"
DJANGO_ALLOWED_HOSTS="desk.npp.org.gh,localhost,127.0.0.1"

# --- Mode & Base URL ---------------------------------------------------------
# Set DESK_SAMPLE_MODE=0 for live shifts (disables the demo persona switcher)
DESK_SAMPLE_MODE=0
DESK_BASE_URL="https://desk.npp.org.gh"

# --- Database ----------------------------------------------------------------
# For production (PostgreSQL):
# DATABASE_URL="postgresql://npp_user:secure_password@localhost:5432/npp_desk"
# Docker Compose (deploy/docker-compose.yml) needs this; use a long random value and reuse it in DATABASE_URL.
# POSTGRES_PASSWORD=""
# For SQLite (default file-based storage):
DESK_DATABASE="../data/live.sqlite3"

# --- Social & Broadcast Media Collector Credentials --------------------------
# X (Twitter) API v2 Bearer Token (for Recent Search API)
X_BEARER_TOKEN=""
# Optional: customize search terms (defaults to Ghanaian political issues and party keywords)
# X_SEARCH_QUERY='(NPP OR Bawumia OR Akufo-Addo OR "dumsor" OR "galamsey" OR "cedi" OR "PURC" OR "tariff") -is:retweet'

# YouTube Data API v3 Key (Optional; public channel feeds monitor 7 national stations without credentials)
YOUTUBE_API_KEY=""

# --- Instant Alert Dispatch (Telegram War Room Pilot) -----------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# Designated War Room internal channel or group chat ID (e.g. -1001234567890)
TELEGRAM_CHAT_ID=""

# --- Security & SSL (When DJANGO_DEBUG=0) -------------------------------------
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# --- Behind Nginx (deploy/nginx.conf) -----------------------------------------
# Trust Nginx's X-Real-IP and X-Forwarded-Proto. Required behind the proxy: without it HTTPS
# redirects loop and sign-in lockout sees every visitor as one address. Leave at 0 if the app
# is ever reachable without Nginx in front.
DESK_TRUST_PROXY_HEADERS=1

# --- Sign-in protection -------------------------------------------------------
# DESK_SIGNIN_MAX_FAILURES=5
# DESK_SIGNIN_MAX_FAILURES_PER_IP=20
# DESK_SIGNIN_LOCK_MINUTES=15

# --- Backups and health -------------------------------------------------------
# DESK_BACKUP_DIR="/opt/npp-listening-desk/backups"
# /healthz/ reports 503 when trends or collection are older than these (minutes)
# DESK_HEALTH_MAX_TREND_AGE_MINUTES=5
# DESK_HEALTH_MAX_POLL_AGE_MINUTES=20

